{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handgames",
  "compatibility_date": "2026-04-04",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  // Serve only through the production domain: no workers.dev URL, no version
  // preview URLs. Domains/routes are managed outside this file (do not declare
  // "routes" here without reviewing what it would replace).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "ROOMS",
      "id": "1d4f535b94a44eb18debf39489b9aef7"
    }
  ]
}
