{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8082"],
      "port": 8082
    },
    {
      "name": "worker-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--port", "8788", "--persist-to", "/tmp/hg-wrangler-state"],
      "port": 8788
    }
  ]
}
