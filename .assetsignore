# Files/dirs that must never be uploaded as public static assets.
# Cloudflare Workers (unlike Pages) does NOT auto-exclude .git, node_modules, etc.
# https://developers.cloudflare.com/workers/static-assets/binding/#ignoring-assets

.git
.github
.claude
.wrangler
node_modules
.DS_Store
.gitignore
.assetsignore
.env*
.dev.vars*

# Worker source (bundled via "main" in wrangler.jsonc, never a public asset)
/worker.js

# Dev-only scripts and configs — not needed by visitors
*.command
docker-compose.yml
wrangler.jsonc
nginx
/scripts
test
tests
package.json
package-lock.json
*.log
*.map

# Internal SEO/content planning docs (and any other markdown)
*.md
